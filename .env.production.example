# =============================================================================
# Hanuman Marketing Portal — Production Environment Variables (UpCloud)
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to git — it contains secrets.
# =============================================================================

# ── PostgreSQL (UpCloud Managed Database) ────────────────────────────────────
POSTGRES_USER=hanuman
POSTGRES_DB=hanuman
DATABASE_URL=postgresql://hanuman:CHANGE_ME@db-xxxxxxxx.db.upclouddatabases.com:5432/hanuman?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://traintrack.work,https://www.traintrack.work

# ── Service Ports ─────────────────────────────────────────────────────────────
LEAD_SERVICE_PORT=5001

# ── Gateway — connection to TrainTrack (on its own UpCloud server) ────────────
# If TrainTrack is on a different server, use its public IP or private network IP
TRAINTRACK_AUTH_URL=https://app.traintrack.work/api/auth
# Public URL of the TrainTrack LMS frontend — REQUIRED for SSO redirect after login.
# Without this the gateway defaults to http://localhost:3000 and SSO breaks in prod.
TRAINTRACK_FRONTEND_URL=https://app.traintrack.work
TRAINTRACK_DB_URL=postgresql://traintrack:CHANGE_ME@db-xxxxxxxx.db.upclouddatabases.com:5432/traintrack?sslmode=require
TRAINTRACK_DB_USER=traintrack
TRAINTRACK_DB_PASS=CHANGE_ME
TRAINTRACK_DB_NAME=traintrack

# Public URL of THIS Hanuman portal (used for the "Sign in" link in reset emails)
PORTAL_URL=https://traintrack.work

# ── Email / SMTP (transactional email) ────────────────────────────────────────
# Used for: password-reset emails, audit-booking confirmations, contact-form and
# new-lead notifications to your sales team, and newsletter welcomes.
# Leave SMTP_HOST blank to disable email (flows still work; reset falls back to
# showing the temp password inline). Works with any provider's SMTP relay
# (SendGrid, Amazon SES, Mailgun, Postmark, Google Workspace, etc.).
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=noreply@traintrack.work
SMTP_FROM_NAME=TrainTrack
SMTP_TLS=true
# Internal inbox that new-lead / contact-form notifications are sent to
SALES_NOTIFY_EMAIL=sales@traintrack.work

# ── Docker Image Tag ──────────────────────────────────────────────────────────
IMAGE_TAG=latest
